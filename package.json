{
  "name": "problemes-caches",
  "version": "0.1.0",
  "private": true,
  "description": "Problèmes cachés dans les tickets — regroupe les incidents JSM de même origine et chiffre leur coût (Atlassian Forge · Codegeist 2026)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --import ./tools/strip_ts_loader.mjs \"src/**/*.test.ts\"",
    "test:core": "node --test --experimental-strip-types --import ./tools/strip_ts_loader.mjs src/core/*.test.ts",
    "lint": "forge lint",
    "build": "forge build",
    "check": "npm run typecheck && npm run test",
    "limits": "python3 tools/check_limits.py"
  },
  "dependencies": {
    "@forge/api": "^8.5.0",
    "@forge/bridge": "^7.3.0",
    "@forge/events": "^3.0.10",
    "@forge/llm": "^1.0.10",
    "@forge/react": "12.5.0",
    "@forge/resolver": "^2.0.2",
    "@forge/sql": "^4.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@forge/manifest": "^13.9.0",
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "js-yaml": "^4.3.2",
    "typescript": "^5.7.0",
    "@types/react": "^18.2.64"
  }
}
